# ~/.zshrc for CachyOS/Arch clients — deployed by bootstrap_scripts/cachyos_bootstrap.sh.
# Linux counterpart to zsh/.zshrc (which is macOS/Homebrew-specific).

# ── history ──────────────────────────────────────────────────────────────────
HISTSIZE=1000000; SAVEHIST=1000000; HISTFILE=~/.zsh_history
setopt APPEND_HISTORY SHARE_HISTORY INC_APPEND_HISTORY HIST_IGNORE_SPACE HIST_EXPIRE_DUPS_FIRST

export DOTFILES="$HOME/Dev/dotfiles"
export DOTFILE_HOME="$DOTFILES"

# ── PATH (Linux) ─────────────────────────────────────────────────────────────
export PATH="$HOME/bin:$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
[ -d "$HOME/go/bin" ]        && export PATH="$PATH:$HOME/go/bin"
[ -d "$HOME/.lmstudio/bin" ] && export PATH="$PATH:$HOME/.lmstudio/bin"

# ── oh-my-zsh ────────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git kubectl zoxide fzf zsh-autosuggestions zsh-syntax-highlighting)
[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"
[ -f "$HOME/.oh-my-zsh-conf" ] && source "$HOME/.oh-my-zsh-conf"   # your extra omz tweaks from the repo

# ── toolchains ───────────────────────────────────────────────────────────────
command -v pyenv >/dev/null && { export PYENV_ROOT="$HOME/.pyenv"; eval "$(pyenv init - zsh)"; }
[ -s "$HOME/.nvm/nvm.sh" ]    && . "$HOME/.nvm/nvm.sh"          # only if you install nvm (pacman node works too)
[ -s "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"      # uv / cargo env

# ── local AI workstation helpers (claude-local, aiping, aimodels, aiask) ─────
# reads gateway URL + key from $DOTFILES/untracked/.ai_env (gitignored) if present
[ -f "$DOTFILES/zsh/.ai" ] && source "$DOTFILES/zsh/.ai"

# ── kubernetes — both clusters merged into ~/.kube/config ────────────────────
export KUBECONFIG="$HOME/.kube/config"
alias kb="kubectl"
alias kbx="kubectx"     # kubectx rmhome | kubectx monlash
alias kbn="kubens"
setns() { [ -z "$1" ] && { echo "usage: setns <ns>"; return 1; }; export KUBE_NAMESPACE="$1"; alias kb="kubectl -n $1"; echo "✅ ns=$1"; }

# ── clipboard (Wayland/X fallbacks for pbcopy/pbpaste) ───────────────────────
if command -v wl-copy >/dev/null; then alias pc="wl-copy"; alias pp="wl-paste"
elif command -v xclip >/dev/null; then alias pc="xclip -sel clip"; alias pp="xclip -sel clip -o"; fi

# ── general aliases ──────────────────────────────────────────────────────────
alias cl="clear"
alias rzsh="source ~/.zshrc"
alias ezsh="nvim $DOTFILES/zsh/.zshrc.linux"
alias lsl="eza -lh --group-directories-first 2>/dev/null || ls -lhS"
alias lsla="eza -lah --group-directories-first 2>/dev/null || ls -lahS"
alias tojson="python -m json.tool"
alias tf="terraform"

# ── git aliases ──────────────────────────────────────────────────────────────
alias gd="git diff"; alias gst="git status"; alias glo="git log --oneline"
alias grh="git reset HEAD"; alias gck="git checkout --"; alias gckt="git checkout --track"
alias gcane="git commit --amend --no-edit"; alias unstage="git restore --staged"
alias undocommit="git reset --soft HEAD~1"
alias gcm='git symbolic-ref --short refs/remotes/origin/HEAD | sed "s|origin/||" | xargs git checkout'

# ── prompt: uncomment to use starship instead of the omz theme ───────────────
# command -v starship >/dev/null && eval "$(starship init zsh)"
