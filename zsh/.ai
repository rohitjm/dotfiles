########################################
# LOCAL AI WORKSTATION
#
# Inference runs on the workstation (RTX PRO 6000 96GB): Ollama behind a LiteLLM
# gateway that speaks both the Anthropic and OpenAI APIs.
#
# This file is portable and lives in git. It works on BOTH:
#   - the workstation itself (which also gets the server-side helpers), and
#   - any LAN client (which just needs the URL + key).
#
# The gateway URL and API key are machine-specific and the key is a secret, so
# they live in untracked/.ai_env (gitignored), not here. On a new client:
#
#     mkdir -p ~/Dev/dotfiles/untracked
#     cat > ~/Dev/dotfiles/untracked/.ai_env <<'EOF'
#     AI_GATEWAY_URL=http://<workstation-lan-ip>:4000
#     AI_GATEWAY_KEY=sk-...            # LITELLM_MASTER_KEY from the workstation
#     EOF
#
# Run `ai-client-config` on the workstation to print exactly that block.
########################################

echo "Loaded AI workstation config!!"

export AI_STACK="$HOME/Dev/ai-stack"          # only exists on the workstation

# Per-machine config (URL + key). Gitignored; absent on a fresh clone.
[[ -f "$DOTFILE_HOME/untracked/.ai_env" ]] && . "$DOTFILE_HOME/untracked/.ai_env"

# Do NOT default to a hardcoded LAN address. That IP comes from DHCP and it has
# already moved once, which silently broke both the clients and the workstation
# itself -- the Windows portproxy went on listening on an address the machine no
# longer held, so everything looked configured and nothing answered.
#
# Loopback is always right on the workstation, and it skips the pointless trip
# out through the portproxy and back. Clients override this in untracked/.ai_env
# (run ai-client-config on the workstation to print the block).
export AI_GATEWAY_URL="${AI_GATEWAY_URL:-http://127.0.0.1:4000}"

# Key resolution, in order: explicit env -> untracked/.ai_env -> the gateway's own
# .env (workstation only). Clients only ever have the first two.
_ai_key() {
  if [[ -n "$AI_GATEWAY_KEY" ]]; then
    print -r -- "$AI_GATEWAY_KEY"
    return 0
  fi
  if [[ -f "$AI_STACK/.env" ]]; then
    grep -m1 '^LITELLM_MASTER_KEY=' "$AI_STACK/.env" | cut -d= -f2-
    return 0
  fi
  echo "No gateway key. Create $DOTFILE_HOME/untracked/.ai_env with AI_GATEWAY_URL and AI_GATEWAY_KEY." >&2
  echo "On the workstation, run: ai-client-config" >&2
  return 1
}

# Model aliases the gateway serves (minus the "*" catch-all route).
_ai_model_list() {
  local key; key="$(_ai_key)" || return 1
  curl -s -m 10 "$AI_GATEWAY_URL/v1/models" -H "Authorization: Bearer $key" \
    | python3 -c 'import sys,json
for m in json.load(sys.stdin)["data"]:
    if m["id"] != "*": print(m["id"])' 2>/dev/null
}

# Run Claude Code against local inference instead of the Anthropic API.
#
#   claude-local                 pick a model interactively
#   claude-local -m qwen3-coder   choose one up front
#   AI_MODEL=qwen3-coder claude-local
claude-local() {
  local key model
  key="$(_ai_key)" || return 1

  # -m/--model consumes its argument; everything else passes through to claude.
  local -a passthru=()
  while (( $# )); do
    case "$1" in
      -m|--model) model="$2"; shift 2 ;;
      *)          passthru+=("$1"); shift ;;
    esac
  done

  model="${model:-${AI_MODEL:-}}"

  # No model given: ask the gateway what it serves and let the user pick. Falls
  # back to qwen3.6 when non-interactive (scripts, pipes) or fzf is absent.
  if [[ -z "$model" ]]; then
    local models; models="$(_ai_model_list)"
    if [[ -n "$models" && -t 0 && -t 1 ]] && command -v fzf >/dev/null 2>&1; then
      model="$(print -r -- "$models" | fzf --height=40% --reverse \
                 --prompt='model> ' --header='Local model for this Claude Code session')"
    fi
    : "${model:=qwen3.6}"
  fi

  echo "claude-local: using '$model' via $AI_GATEWAY_URL"

  # --model is passed explicitly because a model saved in Claude Code's settings
  # (whatever /model last selected, e.g. claude-opus-4-8) OUTRANKS the
  # ANTHROPIC_MODEL env var -- which is what made the gateway 400 on an unknown
  # model name. A CLI flag outranks both.
  #
  # Every tier points at the same model on purpose: Ollama holds one model in
  # VRAM (OLLAMA_MAX_LOADED_MODELS=1), so sending the small/background calls to a
  # *different* model would evict the 65GB one and force a reload on the very
  # next real request.
  ANTHROPIC_BASE_URL="$AI_GATEWAY_URL" \
  ANTHROPIC_AUTH_TOKEN="$key" \
  ANTHROPIC_MODEL="$model" \
  ANTHROPIC_SMALL_FAST_MODEL="$model" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="$model" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="$model" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="$model" \
  claude --model "$model" "${passthru[@]}"
}

# Works from anywhere: what can the gateway serve, and is it up?
aimodels() { _ai_model_list }

aiping() {
  if curl -sf -m 5 "$AI_GATEWAY_URL/health/liveliness" >/dev/null 2>&1; then
    echo "gateway up: $AI_GATEWAY_URL"
  else
    echo "gateway UNREACHABLE: $AI_GATEWAY_URL" >&2
    return 1
  fi
}

# One-shot prompt against the local stack.
aiask() {
  local key; key="$(_ai_key)" || return 1
  curl -s -m 600 "$AI_GATEWAY_URL/v1/chat/completions" \
    -H "Authorization: Bearer $key" -H "Content-Type: application/json" \
    -d "{\"model\":\"${AI_MODEL:-qwen3.6}\",\"messages\":[{\"role\":\"user\",\"content\":\"$*\"}]}" \
    | python3 -c 'import sys,json; print(json.load(sys.stdin)["choices"][0]["message"]["content"])'
}

########################################
# Workstation-only helpers.
# Skipped on clients, where there is no gateway to manage and no GPU to inspect.
########################################
if [[ -d "$AI_STACK" ]]; then

  alias aiup="$AI_STACK/up.sh"
  alias aidown="docker compose -f $AI_STACK/docker-compose.yml down"
  alias ailogs="docker compose -f $AI_STACK/docker-compose.yml logs -f litellm"

  # VRAM state + what's currently resident on the GPU.
  aigpu() {
    nvidia-smi --query-gpu=memory.used,memory.total,utilization.gpu,temperature.gpu \
               --format=csv,noheader
    echo "--- models loaded in VRAM ---"
    curl -s -m 5 "http://$(ip route show default | awk '{print $3; exit}'):11434/api/ps" \
      | python3 -m json.tool 2>/dev/null || echo "(ollama unreachable)"
  }

  # Print the block to drop into untracked/.ai_env on a client machine.
  ai-client-config() {
    local key; key="$(_ai_key)" || return 1
    local lan; lan="$(_ai_lan_url)" || return 1
    cat <<EOF
# Add to ~/Dev/dotfiles/untracked/.ai_env on the CLIENT machine:
AI_GATEWAY_URL=$lan
AI_GATEWAY_KEY=$key
EOF
  }

  # The workstation's LAN URL (not loopback) -- what clients must point at.
  _ai_lan_url() {
    local ip
    ip="$(/mnt/c/Windows/System32/ipconfig.exe 2>/dev/null | tr -d '\r' \
          | grep -oE '10\.0\.0\.[0-9]+' | head -1)"
    # Never fall back to a guess. A wrong-but-plausible address is what made the
    # last failure so hard to see: everything looked configured and nothing answered.
    if [[ -z "$ip" ]]; then
      echo "Could not determine the workstation's LAN IP from ipconfig." >&2
      return 1
    fi
    print -r -- "http://${ip}:4000"
  }

fi
